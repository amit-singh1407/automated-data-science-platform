# ═══════════════════════════════════════════════════════════════════════════════
# AutoData AI / CleanCart - Production .gitignore
# ═══════════════════════════════════════════════════════════════════════════════

# Python bytecode & cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing, type checking & coverage
.pytest_cache/
**/.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Databases & local persistent storage
*.db
*.sqlite
*.sqlite3
autodata.db
**/autodata.db

# User dataset uploads & generated artifacts
uploads/
**/uploads/
**/uploads/*
backend/uploads/
benchmark-results.json
**/benchmark-results.json
*.parquet
*.xlsx
report.pdf
**/report.pdf

# Node.js & Frontend builds
node_modules/
**/node_modules/
dist/
**/dist/
.vite/
**/.vite/
frontend/.vite/
.turbo/
.parcel-cache/
.eslintcache

# Logs
*.log
logs/
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files & secrets
.env
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Operating System & IDE artifacts
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*.tmp
*.bak
